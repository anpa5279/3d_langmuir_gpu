#!/bin/bash
nodes=1
cpus=128
procs=32
ntasks=$((nodes*procs))
threads=$((cpus/procs))
jobn=sj0.1-mld60-dTdz0.01-z96-nz64
file=T-periodicboundary.jl

rm -rf outputs/resolution_test/$jobn/
mkdir outputs/resolution_test/$jobn/

cp $file outputs/resolution_test/$jobn/

cd outputs/resolution_test/$jobn/

cat > EXEC_STEP << EXEC
#!/bin/sh

#PBS -A UCUB0166
#PBS -N $jobn
#PBS -q main 
#PBS -j oe
###PBS -l job_priority=economy
#PBS -l walltime=2:00:00
#PBS -l select=$nodes:ncpus=$cpus:mpiprocs=$procs

export JULIA_NUM_PRECOMPILE_TASKS=$threads
export JULIA_NUM_THREADS=$threads

module --force purge
module load ncarenv/23.09 nvhpc/24.7 cray-mpich/8.1.29

module list

julia --project -e 'import Pkg'
julia --project -e 'using Pkg; Pkg.instantiate()'
julia --project -e 'using Pkg; Pkg.add(Pkg.PackageSpec(;name="Oceananigans", version="0.106.6"))'
mpiexec -n $ntasks -ppn $procs julia --project $file

EXEC

qsub < EXEC_STEP