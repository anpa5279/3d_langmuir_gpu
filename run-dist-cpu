#!/bin/bash
nodes=1
cpus=128
procs=32
ntasks=$((nodes*procs))
threads=$((cpus/procs))
jobn=sj0.1-mld60-dTdz0.005
file=T-periodicboundary-closureRe.jl

rm -rf outputs/$jobn/
mkdir outputs/$jobn/

cp $file outputs/$jobn/

cd outputs/$jobn/

cat > EXEC_STEP << EXEC
#!/bin/sh

#PBS -A UCUB0166
#PBS -N $jobn
#PBS -q main 
#PBS -j oe
#PBS -l job_priority=economy
#PBS -l walltime=8:00:00
#PBS -l select=$nodes:ncpus=$cpus:mpiprocs=$procs

export JULIA_NUM_PRECOMPILE_TASKS=$threads
export JULIA_NUM_THREADS=$threads

module --force purge
module load ncarenv/23.09 nvhpc/24.7 cray-mpich/8.1.29

module list

julia --project -e 'import Pkg'
julia --project -e 'using Pkg; Pkg.instantiate()'
mpiexec -n $ntasks -ppn $procs julia --project $file

EXEC

qsub < EXEC_STEP