#!/bin/bash
nodes=1
cpus=64
gpus=1
ntasks=$((nodes*gpus))
nthreads=$((cpus/gpus))
jobn=dxi05
file=T-periodicboundary.jl

mkdir -p $jobn/

cp $file $jobn/

cd $jobn/ | exit 1

cat > EXEC_STEP << EXEC
#!/bin/bash -l
#SBATCH --export=NONE
#SBATCH --account=ucb-general
#SBATCH --partition=aa100
#SBATCH --qos=gpu-testing
#SBATCH --job-name=$jobn
#SBATCH --time=00:30:00
#SBATCH --nodes=$nodes
#SBATCH --ntasks=$ntasks
#SBATCH --gres=gpu:a100-100gb:$gpus
#SBATCH --output=$jobn-%j.out

export JULIA_NUM_PRECOMPILE_TASKS=$nthreads
export JULIA_NUM_THREADS=$nthreads

module load julia/1.11.6 cuda/12.2.1 aocc/3.2.0 openmpi/4.1.4

module list

export MPICH_GPU_SUPPORT_ENABLED=1
export MPICH_GPU_MANAGED_MEMORY_SUPPORT_ENABLED=1

export JULIA_MPI_HAS_CUDA=true
export PALS_TRANSFER=false
export JULIA_CUDA_MEMORY_POOL=none

julia --project -e 'using Pkg; Pkg.instantiate()'

julia --project -e 'Pkg.add("MPIPreferences"); Pkg.add("MPI"); Pkg.add("CUDA"), Pkg.add("Oceananigans")'

julia --project -e 'using MPIPreferences; MPIPreferences.use_system_binary()'
julia --project -e 'using MPI; using CUDA; CUDA.precompile_runtime()'

mpirun -n $ntasks -ppn $gpus set_gpu_rank julia --project $file
EXEC

sbatch EXEC_STEP